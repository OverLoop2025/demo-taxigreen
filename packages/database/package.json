{
  "name": "@taxigreen/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "echo \"(pkg/database) sin tests aún (Sprint 0)\"",
    "build": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-guion": "pnpm db:seed && tsx prisma/seed-guion.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "nanoid": "^5.1.11"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
