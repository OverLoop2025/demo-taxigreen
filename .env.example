# =====================================================================
# .env.example — RAÍZ del monorepo Taxi Green (Sprint 0)
# Copia a `.env` y completa. Todas las variables están comentadas; en
# Sprint 0 nada es obligatorio para typecheck/lint/test/build.
# Hay .env.example específicos en apps/web y apps/driver.
# =====================================================================

# --- Entorno ---
# NODE_ENV=development

# --- Base de datos (Supabase / Postgres) ---
# DATABASE_URL (pooler 6543) y DIRECT_URL (5432) según docs de Supabase.
# DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Supabase (Realtime + Storage) ---
# NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."   # solo servidor, nunca al cliente

# --- IA (Anthropic) — patrón withFallback ---
# IA_HABILITADA=false               # false => sistema 100% determinista
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL_EXTRACCION="claude-sonnet-4-6"
# ANTHROPIC_MODEL_RAPIDO="claude-haiku-4-5-20251001"

# --- Mapas (Mapbox) ---
# NEXT_PUBLIC_MAPBOX_TOKEN="pk...."   # tiles del mapa web (cliente, seguro en NEXT_PUBLIC_)
# MAPBOX_DOWNLOAD_TOKEN="sk...."      # descarga del SDK nativo @rnmapbox/maps en EAS (NOT para Directions)
# MAPBOX_SERVER_TOKEN="pk...."        # Directions server-side (ruta/ETA/tráfico); puede ser el mismo pk.* de tiles

# --- Routing en tiempo real (S9) — patrón withRutaFallback ---
# RUTAS_HABILITADAS="false"           # true = Mapbox Directions real; false = estimación haversine (default seguro)
# RUTAS_VELOCIDAD_KMH="28"            # velocidad media Lima para estimador determinista
# RUTAS_UMBRAL_RECALCULO_M="120"      # metros mínimos de desplazamiento para recalcular
# RUTAS_INTERVALO_MIN_S="6"           # segundos mínimos entre recálculos

# --- Expo / app conductor ---
# EXPO_PUBLIC_EXPO_PROJECT_ID="..."   # requerido para obtener Expo Push Token real

# --- Seguridad ---
# HMAC_SECRET="cambia-esto-en-prod"  # firma de vouchers/QR
# AUTH_SECRET="cambia-esto-en-prod"  # Auth.js v5

# --- Integraciones (demo: stubs) ---
# RENIEC_API_TOKEN="..."             # APIs.net.pe (free 100/día)
# RESEND_API_KEY="re_..."

# --- Observabilidad (demo: Sentry dummy) ---
# SENTRY_DSN=""                      # vacío en demo
