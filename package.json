{
  "name": "taxigreen",
  "private": true,
  "version": "0.0.0",
  "description": "Demo Taxi Green — monorepo (apps/web Next.js + apps/driver Expo).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"],
    "overrides": {
      "@types/react-dom>@types/react": "19.2.6",
      "react-native-css-interop": "0.1.22"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@rnmapbox/maps>react-native": "0.74.5",
        "next-auth>next": "15.4.11",
        "next-auth>react": "19.0.0"
      }
    }
  }
}
