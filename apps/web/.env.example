# =====================================================================
# .env.example — apps/web (Next.js). Copia a apps/web/.env.local
# Sprint 0: todo opcional (build/typecheck no fallan sin secretos).
# =====================================================================

# NODE_ENV=development

# --- IA (withFallback) ---
# IA_HABILITADA=false
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_EXTRACCION=claude-sonnet-4-6
# ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5-20251001

# --- Base de datos (Supabase / Postgres) ---
# DATABASE_URL=postgresql://postgres:[pwd]@[host]:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:[pwd]@[host]:5432/postgres

# --- Supabase Realtime + Storage (públicas) ---
# NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Mapas y routing ---
# Token para tiles del mapa web (cliente, seguro en NEXT_PUBLIC_).
# NEXT_PUBLIC_MAPBOX_TOKEN=pk....
#
# Token para Directions API server-side (ruta/ETA/tráfico). NUNCA en NEXT_PUBLIC_.
# Puede ser el mismo pk.* de tiles si tiene scopes por defecto (Directions viene habilitado).
# MAPBOX_SERVER_TOKEN=pk....
#
# Routing en tiempo real (S9). true = Mapbox Directions; false = estimación haversine (default).
# RUTAS_HABILITADAS=false
# RUTAS_VELOCIDAD_KMH=28        # velocidad media Lima para el estimador determinista
# RUTAS_UMBRAL_RECALCULO_M=120  # metros mínimos de desplazamiento para recalcular
# RUTAS_INTERVALO_MIN_S=6       # segundos mínimos entre recálculos

# --- Seguridad ---
# AUTH_SECRET=cambia-esto
# HMAC_SECRET=cambia-esto

# --- Integraciones / correo ---
# RENIEC_API_TOKEN=...
# RESEND_API_KEY=re_...

# --- Observabilidad (Sentry dummy en demo) ---
# SENTRY_DSN=
# LOG_LEVEL=debug
