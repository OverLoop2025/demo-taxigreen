# =====================================================================
# .env.example — apps/driver (Expo). Copia a apps/driver/.env
# En Expo, lo que va al bundle usa prefijo EXPO_PUBLIC_.
# Sprint 0: todo opcional (defaults seguros).
# =====================================================================

# URL del backend Next.js consumido por la app (login, fcm-token, asignación).
# En Android físico, no uses localhost: usa la IP LAN/WSL visible desde el teléfono.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase Realtime (mismo proyecto que web).
# EXPO_PUBLIC_SUPABASE_URL=https://[project].supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...

# Expo Push Token. En Expo Go moderno, `getExpoPushTokenAsync` necesita projectId.
# EXPO_PUBLIC_EXPO_PROJECT_ID=...

# Mapbox (mapa nativo @rnmapbox/maps).
# EXPO_PUBLIC_MAPBOX_TOKEN=pk....

# Routing en app conductor (mismos defaults que web; no son secretos).
# EXPO_PUBLIC_RUTAS_UMBRAL_RECALCULO_M=120
# EXPO_PUBLIC_RUTAS_INTERVALO_MIN_S=6

# Token de descarga de Mapbox para build Android (@rnmapbox/maps). Solo build/EAS.
# MAPBOX_DOWNLOAD_TOKEN=sk....
