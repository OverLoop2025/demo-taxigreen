# Linker AISLADO (symlinks, default de pnpm). Necesario porque el monorepo tiene
# DOS versiones de React: apps/web (React 19) y apps/driver (React 18.2 / Expo SDK 51).
# Con node-linker=hoisted, una sola react se hoistea al root y la otra queda nested,
# provocando "dos copias de React" (useContext null en el build de Next). Aislado da
# a cada app su árbol correcto. Metro (Expo 51) resuelve symlinks; metro.config.js
# ya añade watchFolders + nodeModulesPaths para el monorepo.
node-linker=isolated
auto-install-peers=true
strict-peer-dependencies=false

# Instalación conservadora en memoria (evita OOM en WSL2 con poca RAM).
child-concurrency=1
network-concurrency=3

# Hoist público para que Metro/Expo encuentren dependencias nativas del driver.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@rnmapbox/*
public-hoist-pattern[]=*nativewind*

# Herramientas de build CSS: Next/PostCSS las resuelve por string desde el cwd de
# apps/web; con isolated no quedan accesibles si no se hoistean públicamente.
public-hoist-pattern[]=postcss
public-hoist-pattern[]=autoprefixer
public-hoist-pattern[]=tailwindcss
