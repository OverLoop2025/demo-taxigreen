{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "IA_HABILITADA",
    "ANTHROPIC_API_KEY",
    "DATABASE_URL",
    "DIRECT_URL",
    "RUTAS_HABILITADAS",
    "MAPBOX_SERVER_TOKEN",
    "RUTAS_VELOCIDAD_KMH",
    "RUTAS_UMBRAL_RECALCULO_M",
    "RUTAS_INTERVALO_MIN_S"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
